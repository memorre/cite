DATABASE_URL="postgres://user:password@host:5432/db?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Set ONE chat provider key. Embeddings (required for search) always need
# OPENAI_API_KEY specifically, regardless of which chat provider you pick —
# see README.
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# MOONSHOT_API_KEY="sk-..."
